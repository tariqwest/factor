#!/usr/bin/env bash
# Factor BYOP dogfood helper — documents manual multi-provider verification.
# Does not drive the GUI. Pair with factor_openrouter_manual_verify for OpenRouter.
set -euo pipefail
cd "$(dirname "$0")/.."

usage() {
    cat <<'USAGE'
Usage: script/factor_byop_manual_verify [--print-steps]

Manual dogfood matrix for Factor multi-provider BYOP (no Warp account).

Prerequisites
  - Built binary: cargo build -p warp --bin factor-oss
    (macOS GUI needs Metal tools / Xcode CLT with `xcrun metal`; without Metal,
     compile may soft-skip shaders and the app may not render a full GUI.)
  - Settings: ~/.factor/settings.toml (or Factor data domain)
  - API keys: Providers UI (Agents → Providers) or secure storage — not plain TOML for secrets

Matrix — **generic OpenAI-compatible is primary** (one code path). Add providers via Settings → Agents → Providers (base_url + key + model).

  | # | Provider style (OpenAI-compat `base_url`) | Example base_url | Expect |
  |---|-------------------------------------------|----------------|--------|
  | 1 | **Local generic** (must) — `omlx` / `LiteLLM` / Apple FM serve / `LM Studio` / `Jan` / `omniroute` | `http://localhost:11434/v1` (LM Studio default) or `http://localhost:12434/engines/llama.cpp/v1` (Jan), `http://localhost:8000/v1` (LiteLLM) | /model shows `byop:…`; agent multi-turn tool loop (shell → read → final) |
  | 2 | **Remote gateway generic** (must) — `OpenRouter` / Vercel AI Gateway / `Portkey` / `Requesty` / `Together AI` / `Fireworks AI` / `Groq` / `Cerebras` / `SiliconFlow` | `https://openrouter.ai/api/v1` or `https://ai-gateway.vercel.sh/v1` or `https://api.portkey.ai/v1` | same; gateway routing, no Warp account |
  | 3 | Ollama (secondary) — via OpenAI-compat URL if exposed (`http://localhost:11434/v1`), else native `api_type: Ollama` fallback | `http://localhost:11434` (native) | nice-to-have; not gate |
  | 4 | Anthropic native (opportunistic) | `https://api.anthropic.com/v1` | messages + tools if api_type implemented |
  | 5 | Legacy OpenRouter single-key (deprecated) | Settings → OpenRouter (legacy) | still works; prefer Providers for new setups |

Specialized model overrides (optional, settings.toml)

  [agents.byop]
  title_model_id = "byop:<provider-id>:<model>"
  active_ai_model_id = "..."
  next_command_model_id = "..."

Also
  - /rename-conversation <name>
  - /model picker includes configured BYOP models
  - Local orchestration: start_agent only when orchestration enabled

Automated checks (no keys)
  cargo test -p warp --lib factor_
  cargo test -p warp --lib smoke_merge_byop
  cargo test -p warp --lib fake_provider
  cargo test -p warp --lib start_agent
  ./script/check_factor_static_denylist all-runtime

See also: docs/tech/BYOP_INTEGRATION_STATUS.md, script/factor_openrouter_manual_verify
USAGE
}

case "${1:-}" in
    -h|--help) usage; exit 0 ;;
    ""|--print-steps) usage; exit 0 ;;
    *) echo "Unknown argument: $1"; usage; exit 2 ;;
esac
